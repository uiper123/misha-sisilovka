; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MishaSisilovka"
run/main_scene="res://gui/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://autoload/scene_manager.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"
InputHelper="*uid://cholww48njaeh"
DevConsoleHandler="*res://addons/frog_console/DevConsoleHandler.gd"
PostProcessManager="*res://_core/post_process_manager.tscn"
Console="*res://addons/frog_console/ConsoleLayer.tscn"
MultiplayerManager="*res://autoload/multiplayer_manager.gd"

[display]

window/size/initial_position_type=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/input_helper/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/proton_scatter/plugin.cfg")

[file_customization]

folder_colors={
"res://_core/": "purple",
"res://assets/": "teal",
"res://components/": "blue",
"res://entities/": "orange",
"res://gui/": "pink",
"res://levels/": "green",
"res://resources/": "red"
}

